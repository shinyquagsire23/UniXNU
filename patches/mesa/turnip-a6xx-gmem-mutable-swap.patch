+    * red and blue exchanged and was stored back that way, flipping whole bins on every pass that loaded them (pdx203).
+    */
+   r3d_src_load<CHIP>(cmd, cs, iview, layer, VK_FILTER_NEAREST, CHIP >= A7XX);
 }
 
