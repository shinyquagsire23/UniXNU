                   const struct tu_image_view *iview,
                   uint32_t layer)
 {
-   r3d_src_load<CHIP>(cmd, cs, iview, layer, VK_FILTER_NEAREST, true);
+   /* a6xx writes every attachment to GMEM in WZYX order whatever the color swap of RB_MRT_BUF_INFO (no MUTABLEEN, a7xx+), as
+    * draws do, so a load into GMEM has to undo the swap of the memory itself: it samples with the view's own swap. Only a linear
