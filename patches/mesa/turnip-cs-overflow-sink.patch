@@ -77,6 +77,54 @@ tu_cs_init_suballoc(struct tu_cs *cs, struct tu_device *device,
 /**
  * Finish and release all resources owned by a command stream.
  */
+/* pdx203: host memory a failed stream's packets go to (struct tu_cs's error), a block at a time. */
+struct tu_cs_sink {
+   struct tu_cs_sink *prev;
+   uint32_t size;
+   uint32_t dwords[];
+};
+
+static void
+tu_cs_free_sink(struct tu_cs *cs)
+{
+   while (cs->sink) {
+      struct tu_cs_sink *prev = cs->sink->prev;
+      free(cs->sink);
+      cs->sink = prev;
+   }
+}
+
+void
+tu_cs_sink_reserve(struct tu_cs *cs, uint32_t reserved_size)
+{
+   /* Room for the packet and the CP_COND_REG_EXECs tu_cs_reserve_space adds for an open condition. */
+   const uint32_t need = reserved_size + 3 * TU_COND_EXEC_STACK_SIZE + 16;
+   if (!cs->sink || cs->sink->size < need) {
+      const uint32_t size = MAX2(need, 16384);
+      struct tu_cs_sink *sink = (struct tu_cs_sink *)
+         malloc(sizeof(struct tu_cs_sink) + size * sizeof(uint32_t));
+      if (!sink)
+         abort();
+      sink->prev = cs->sink;
+      sink->size = size;
+      cs->sink = sink;
+   }
+   cs->start = cs->cur = cs->sink->dwords;
+   cs->reserved_end = cs->cur + reserved_size;
+   cs->end = cs->sink->dwords + cs->sink->size;
+}
+
+void
+tu_cs_fail(struct tu_cs *cs, VkResult result, uint32_t reserved_size)
+{
+   if (!cs->error) {
+      cs->error = result;
+      mesa_loge("pdx203: command stream %s could not grow by %u dwords (VkResult %d): its packets are dropped and its command "
+                "buffer fails", cs->name ? cs->name : "?", reserved_size, (int) result);
+   }
+   tu_cs_sink_reserve(cs, reserved_size);
+}
+
