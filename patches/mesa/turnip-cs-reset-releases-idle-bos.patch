  */
+extern uint64_t tu_pdx203_cs_stats[10];
+
 void
 tu_cs_reset(struct tu_cs *cs)
 {
@@ -612,7 +615,23 @@ tu_cs_reset(struct tu_cs *cs)
       cs->start = cs->cur = cs->reserved_end = (uint32_t *) cs->read_only.bos[0]->map;
       cs->end = cs->start + tu_sanitize_ib_size(cs->read_only.bos[0]->size /
                                                 sizeof(uint32_t));
+
+      /* pdx203 (usb-147, usb-171): a growing stream kept its last BO, the largest, across resets, and its next BOs as large, so every
+       * command buffer that once recorded a large frame held a large BO for good: the Metal runtime keeps every command pool it made
+       * (metal2vulkan spares.rs), and the render server's "cmd cs" BOs came to 299 MiB in 447 BOs, a third of its 1 GiB GPU window.
+       * Only where tu_reset_cmd_buffer found the command buffer idle (no queue submission holds it, its last one retired) and asked:
+       * sa14..29 released unconditionally and a submission later named a freed BO (usb-170 SUBMITREJ, check 6 handle 0). The BO
+       * goes back to the kernel connection's cache once its last submission retires (darwin_bo_finish). */
+      if (cs->release_large_on_reset && cs->mode == TU_CS_MODE_GROW && cs->read_only.bos[0]->size > 64 * 1024) {
+         TU_RMV(resource_destroy, cs->device, cs->read_only.bos[0]);
+         tu_bo_finish(cs->device, cs->read_only.bos[0]);
+         cs->read_only.bo_count = 0;
+         cs->start = cs->cur = cs->reserved_end = cs->end = NULL;
+         cs->next_bo_size = cs->initial_bo_size;
+         p_atomic_inc(&tu_pdx203_cs_stats[8]);
+      }
    }
+   cs->release_large_on_reset = false;
 
    if (cs->read_write.bo_count) {
       cs->read_write.bos[0] = cs->read_write.bos[cs->read_write.bo_count - 1];
