diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index 5732b96..28da3de 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -4195,12 +4195,47 @@ tu_create_cmd_buffer(struct vk_command_pool *pool,
    return VK_SUCCESS;
 }
 
+/* pdx203: how the Metal runtime's resets and frees of command buffers line up with their submissions, read by the plugin's TCS row
+ * (tu_darwin_cs_stats): resets, resets of one a queue submission still held (vk_command_buffer::pdx203_queued, the runtime's deferred
+ * submits included), resets of one whose last submission the GPU had not finished, then frees and the same two for them, resets that
+ * found the primary's stream holding over 64 KiB, submission entries that named a freed BO (tu_knl_darwin.cc), then the streams' BOs
+ * the idle resets released (tu_cs.cc); slot 9 is spare. Either kind of early reset rewrites (or frees) a
+ * stream the GPU is still to run. */
+uint64_t tu_pdx203_cs_stats[10];
+
+extern "C" __attribute__((visibility("default"))) void tu_darwin_cs_stats(uint64_t out[10]);
+extern "C" __attribute__((visibility("default"))) void
+tu_darwin_cs_stats(uint64_t out[10])
+{
+   for (unsigned i = 0; i < 10; i++)
+      out[i] = p_atomic_read(&tu_pdx203_cs_stats[i]);
+}
+
+/* Counts a reset (slot 0) or a free (slot 3), and one of a command buffer still queued or running. True when it is idle. */
+static bool
+tu_cmd_buffer_note_idle(struct tu_cmd_buffer *cmd_buffer, unsigned slot)
+{
+   p_atomic_inc(&tu_pdx203_cs_stats[slot]);
+   if (p_atomic_read(&cmd_buffer->vk.pdx203_queued)) {
+      p_atomic_inc(&tu_pdx203_cs_stats[slot + 1]);
+      return false;
+   }
+   if (cmd_buffer->pdx203_fence && cmd_buffer->pdx203_queue &&
+       tu_queue_wait_fence(cmd_buffer->pdx203_queue, cmd_buffer->pdx203_fence, 0) == VK_TIMEOUT) {
+      p_atomic_inc(&tu_pdx203_cs_stats[slot + 2]);
+      return false;
+   }
+   return true;
+}
+
 static void
 tu_cmd_buffer_destroy(struct vk_command_buffer *vk_cmd_buffer)
 {
    struct tu_cmd_buffer *cmd_buffer =
       container_of(vk_cmd_buffer, struct tu_cmd_buffer, vk);
 
+   tu_cmd_buffer_note_idle(cmd_buffer, 3);
+
    tu_cs_finish(&cmd_buffer->cs);
    tu_cs_finish(&cmd_buffer->draw_cs);
    tu_cs_finish(&cmd_buffer->tile_store_cs);
@@ -4288,6 +4323,14 @@ tu_reset_cmd_buffer(struct vk_command_buffer *vk_cmd_buffer,
        cmd_buffer->vk.record_result = status_check_result;
     }
 
+   /* pdx203: an idle primary's own stream lets its large kept BO go (tu_cs.cc); nothing but its own entries points into it. */
+   const bool idle = tu_cmd_buffer_note_idle(cmd_buffer, 0);
+   if (cmd_buffer->vk.level == VK_COMMAND_BUFFER_LEVEL_PRIMARY && cmd_buffer->cs.read_only.bo_count &&
+       cmd_buffer->cs.read_only.bos[cmd_buffer->cs.read_only.bo_count - 1]->size > 64 * 1024) {
+      p_atomic_inc(&tu_pdx203_cs_stats[6]);
+      cmd_buffer->cs.release_large_on_reset = idle;
+   }
+
    tu_cs_reset(&cmd_buffer->cs);
    tu_cs_reset(&cmd_buffer->draw_cs);
    tu_cs_reset(&cmd_buffer->tile_store_cs);
