@@ -4180,6 +4180,8 @@
    }
 
    tu_cs_init(&cmd_buffer->cs, device, TU_CS_MODE_GROW, 4096, "cmd cs");
+   /* pdx203: nothing else points into a primary's own stream (tu_cs.h release_large_on_reset). */
+   cmd_buffer->cs.release_large_on_reset = cmd_buffer->vk.level == VK_COMMAND_BUFFER_LEVEL_PRIMARY;
    tu_cs_init(&cmd_buffer->draw_cs, device, TU_CS_MODE_GROW, 4096, "draw cs");
