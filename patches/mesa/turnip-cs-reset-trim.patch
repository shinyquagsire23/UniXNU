+{
+   tu_cs_reset_retaining(cs, TU_CS_RETAINED_BO_DWORDS);
+}
+
+/* As tu_cs_reset, keeping no BO larger than max_dwords (0: none at all).
+ *
+ * A command buffer recycled for the life of the device (the Metal runtime keeps its command pools and command buffers and begins them
+ * again, which resets them) kept its last BO at every reset, the largest its recording ever grew to (each new BO doubles, up to the IB
+ * limit), and next_bo_size never came back down: every command stream held the high-water of its busiest recording, and a render
+ * server's hundreds of them grew with each app switch (pdx203 backboardd: about 300 MiB of 256 KiB to 4 MiB stream BOs after a few
+ * Safari background/foreground passes, the GPU pool full). A last BO above max_dwords is given back with the others and growth starts
+ * again from the stream's initial size; a long recording takes its BOs anew, from the kernel backend's BO cache. */
+void
+tu_cs_reset_retaining(struct tu_cs *cs, uint32_t max_dwords)
 {
    if (cs->mode == TU_CS_MODE_EXTERNAL) {
       assert(!cs->read_only.bo_count && !cs->read_write.bo_count &&
@@ -522,6 +537,24 @@ tu_cs_reset(struct tu_cs *cs)
 
    assert(!cs->writeable);
 
+   if (cs->read_only.bo_count &&
+       cs->read_only.bos[cs->read_only.bo_count - 1]->size > (uint64_t)max_dwords * sizeof(uint32_t)) {
+      TU_RMV(resource_destroy, cs->device, cs->read_only.bos[cs->read_only.bo_count - 1]);
+      tu_bo_finish(cs->device, cs->read_only.bos[cs->read_only.bo_count - 1]);
+      cs->read_only.bo_count = 0;
+      cs->start = cs->cur = cs->reserved_end = cs->end = NULL;
+      if (cs->initial_bo_size)
+         cs->next_bo_size = cs->initial_bo_size;
+   }
+   if (cs->read_write.bo_count &&
+       cs->read_write.bos[cs->read_write.bo_count - 1]->size > (uint64_t)max_dwords * sizeof(uint32_t)) {
+      TU_RMV(resource_destroy, cs->device, cs->read_write.bos[cs->read_write.bo_count - 1]);
+      tu_bo_finish(cs->device, cs->read_write.bos[cs->read_write.bo_count - 1]);
+      cs->read_write.bo_count = 0;
+      if (cs->initial_bo_size)
+         cs->next_bo_size = cs->initial_bo_size;
+   }
+
    if (cs->read_only.bo_count) {
       cs->read_only.bos[0] = cs->read_only.bos[cs->read_only.bo_count - 1];
       cs->read_only.bo_count = 1;
