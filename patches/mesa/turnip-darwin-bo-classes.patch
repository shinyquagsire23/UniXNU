+/* pdx203 (usb-146): backboardd's GPU window filled to 991 of 1024 MiB with only about 380 MiB of it the runtime's memory, and the rest
+ * Turnip's own BOs. The live BOs by name, most bytes first, as "name=MiB/count/peak MiB" separated by spaces (names' spaces as '_'),
+ * after "q<MiB>/<count>": the freed BOs that still hold their range until their last submission retires. */
+extern "C" __attribute__((visibility("default"))) size_t tu_darwin_bo_classes(char *out, size_t cap);
+extern "C" __attribute__((visibility("default"))) size_t
+tu_darwin_bo_classes(char *out, size_t cap)
+{
+   struct darwin_retire_state *retire = darwin_stats_state;
+   if (!cap)
+      return 0;
+   out[0] = 0;
+   if (!retire)
+      return 0;
+   pthread_mutex_lock(&retire->lock);
+   uint64_t queued = 0;
+   for (unsigned i = 0; i < retire->count; ++i)
+      queued += retire->entries[(retire->head + i) % retire->capacity].size;
+   size_t at = (size_t)snprintf(out, cap, "q%llu/%u", (unsigned long long)(queued >> 20), retire->count);
+   bool shown[ARRAY_SIZE(retire->classes)] = {};
+   for (unsigned n = 0; n < retire->class_count && at < cap; ++n) {
+      int best = -1;
+      for (unsigned i = 0; i < retire->class_count; ++i) {
+         if (!shown[i] && (best < 0 || retire->classes[i].bytes > retire->classes[best].bytes))
+            best = (int)i;
+      }
+      shown[best] = true;
+      const struct darwin_bo_class *c = &retire->classes[best];
+      if (!c->count)
+         continue;
+      char name[sizeof(c->name)];
+      unsigned k = 0;
+      for (; c->name[k] && k < sizeof(name) - 1; ++k)
+         name[k] = c->name[k] == ' ' ? '_' : c->name[k];
+      name[k] = 0;
+      at += (size_t)snprintf(out + at, cap - at, " %s=%llu/%llu/%llu", name, (unsigned long long)(c->bytes >> 20),
+                             (unsigned long long)c->count, (unsigned long long)(c->peak >> 20));
+   }
+   pthread_mutex_unlock(&retire->lock);
+   return at < cap ? at : cap - 1;
+}
