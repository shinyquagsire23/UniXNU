+/* Counts a new live BO under its name (under the retire lock); 1 + its index, or 0 when the table is full. */
+static uint8_t
+darwin_bo_class_add(struct darwin_retire_state *retire, const char *name, uint64_t bytes)
+{
+   if (!name)
+      name = "?";
+   unsigned i = 0;
+   while (i < retire->class_count && strncmp(retire->classes[i].name, name, sizeof(retire->classes[i].name) - 1))
+      ++i;
+   if (i == retire->class_count) {
+      if (i == ARRAY_SIZE(retire->classes))
+         return 0;
+      memset(&retire->classes[i], 0, sizeof(retire->classes[i]));
+      strncpy(retire->classes[i].name, name, sizeof(retire->classes[i].name) - 1);
+      ++retire->class_count;
+   }
+   struct darwin_bo_class *c = &retire->classes[i];
+   c->bytes += bytes;
+   ++c->count;
+   if (c->bytes > c->peak)
+      c->peak = c->bytes;
+   return (uint8_t)(i + 1);
+}
