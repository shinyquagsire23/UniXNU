+/* The GPU address space of the device (pdx203: backboardd's window filled while its memory stayed near 430 MiB, and Turnip's command
+ * streams wrote past a block they could not grow): [0] window bytes, [1] handed out, [2] free holes, [3] the largest hole, [4] allocations,
+ * [5] frees, [6] allocations nothing fit, [7] frees refused as overlapping a hole, [8] the highest end above the window's start. */
+extern "C" __attribute__((visibility("default"))) void tu_darwin_va_stats(uint64_t out[9]);
+extern "C" __attribute__((visibility("default"))) void
+tu_darwin_va_stats(uint64_t out[9])
+{
+   struct darwin_retire_state *retire = darwin_stats_state;
+   memset(out, 0, 9 * sizeof(uint64_t));
+   if (!retire)
+      return;
+   pthread_mutex_lock(&retire->lock);
+   const struct darwin_va *va = &retire->va;
+   out[0] = retire->conn.info.va_size;
+   out[1] = va->used;
+   out[2] = va->holes;
+   out[3] = va->largest;
+   out[4] = va->allocs;
+   out[5] = va->frees;
+   out[6] = va->failed;
+   out[7] = va->refused;
+   out[8] = va->high > retire->conn.info.va_start ? va->high - retire->conn.info.va_start : 0;
    pthread_mutex_unlock(&retire->lock);
 }
 
