+/* The largest hole: the size tree's rightmost node (its comparator puts larger keys on the right, see above). */
+static void
+darwin_va_note_largest(struct darwin_va *va)
+{
+   uint64_t largest = 0;
+   for (struct rb_node *x = va->size.root; x; x = x->right)
+      largest = rb_node_data(struct darwin_va_hole, x, by_size)->size;
+   va->largest = largest;
+}
