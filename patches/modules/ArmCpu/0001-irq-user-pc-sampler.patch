+
+// pdx203 user-PC sampler (patches/modules/ArmCpu/0001): while sysctl kern.armcpu_upc holds a pid, every interrupt this handler takes
+// on a core that was running user code of that process records the interrupted PC (ELR_EL1, the exception's own; SPSR_EL1 says the
+// core was at EL0t), the thread's saved LR and its thread ID. A user-space sampler (thread_get_state) only sees a thread at its next
+// kernel entry, so its leaf PCs are the next system call (2026-11-04, sa65: WebContent's busy main thread was 63 % mach_msg). The
+// timer and IPI interrupts sample the running thread wherever it is. Writing a pid restarts the record (0 stops it); reading returns
+// eight words {records, interrupts that wanted to record, from EL1, other process, saved PC disagreed with ELR, 0, 0, 0} and then
+// {pc, lr, tid} per record. The record holds the first 8192. SYSCTL_PROC registers it at startup (a second
+// sysctl_register_oid of this permanent node would panic).
+extern "C" int proc_selfpid (void);
+extern "C" uint64_t thread_tid (thread_t);
+extern "C" void *get_user_regs (thread_t);
+struct ArmCpuUserSample { uint64_t pc, lr, tid; };
+static constexpr uint32_t kUpcEntries = 8192;
+static ArmCpuUserSample gUpc[kUpcEntries];
+static volatile int32_t gUpcPid;
+static volatile uint32_t gUpcStats[5];
+static inline void upcCount (unsigned slot) { __atomic_fetch_add (&gUpcStats[slot], 1u, __ATOMIC_RELAXED); }
+static void sampleUserPc (void)
+{
+  const int32_t pid = gUpcPid;
+  if (pid <= 0) { return; }
+  uint64_t spsr, elr;
+  __asm__ volatile ("mrs %0, spsr_el1" : "=r" (spsr));
+  __asm__ volatile ("mrs %0, elr_el1" : "=r" (elr));
+  upcCount (1);
+  if ((spsr & 0x1f) != 0) { upcCount (2); return; }
+  if (proc_selfpid () != pid) { upcCount (3); return; }
+  thread_t thread = current_thread ();
+  const uint8_t *regs = static_cast<const uint8_t *> (get_user_regs (thread));
+  uint64_t lr = 0;
+  if (regs != nullptr) {
+    lr = *reinterpret_cast<const uint64_t *> (regs + 248);   // arm_saved_state: 8-byte header, x0..x28, fp, lr, sp, pc
+    if (*reinterpret_cast<const uint64_t *> (regs + 264) != elr) { upcCount (4); }
+  }
+  const uint32_t at = __atomic_fetch_add (&gUpcStats[0], 1u, __ATOMIC_RELAXED);
+  if (at < kUpcEntries) { gUpc[at] = {elr, lr, thread_tid (thread)}; }
+}
+static int upcSysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+  if (req->newptr != USER_ADDR_NULL) {
+    int32_t pid = 0;
+    const int error = SYSCTL_IN (req, &pid, sizeof (pid));
+    if (error) { return error; }
+    gUpcPid = 0;
+    __atomic_thread_fence (__ATOMIC_SEQ_CST);
+    if (pid <= 0) { return 0; }   // stop: the record stays for reading
+    for (auto &stat : gUpcStats) { stat = 0; }
+    __atomic_thread_fence (__ATOMIC_SEQ_CST);
+    gUpcPid = pid;
+    return 0;
+  }
+  const uint32_t records = gUpcStats[0] < kUpcEntries ? gUpcStats[0] : kUpcEntries;
+  uint32_t header[8] = {records, gUpcStats[1], gUpcStats[2], gUpcStats[3], gUpcStats[4], 0, 0, 0};
+  int error = SYSCTL_OUT (req, header, sizeof (header));
+  if (!error) { error = SYSCTL_OUT (req, gUpc, records * sizeof (gUpc[0])); }
+  return error;
+}
+SYSCTL_PROC (_kern, OID_AUTO, armcpu_upc, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_LOCKED, nullptr, 0, upcSysctl, "S", "pdx203 user-PC sampler");
