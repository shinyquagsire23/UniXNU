+bool NativeAdrenoVm::mapped(uint64_t iova,uint64_t bytes) const
+{
+    if(!attached_ || !ranges_ || !bytes || iova+bytes<iova)return false;
+    const uint64_t end=iova+bytes;
+    while(iova<end) {
+        const size_t i=rangeAt(iova);
+        if(i>=spanCount() || ranges_[i].iova>iova)return false;
+        iova=ranges_[i].iova+ranges_[i].bytes;
+    }
+    return true;
+}
