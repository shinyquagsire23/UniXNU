NativeAdreno 0008: before a submission reaches the ring, an IB1's CP_INDIRECT_BUFFER calls into unmapped memory become CP_NOPs

pdx203 usb-210: the CP's IB2 fetch of a draw stream whose BO was no longer mapped took an SMMU translation fault and the GPU never
completed anything again. Each such call is printed (GPUGUARD) with what the free log knows of its target.

--- a/NativeAdrenoUserClient.cpp
+++ b/NativeAdrenoUserClient.cpp
@@ -352,7 +352,73 @@
     if(entry->imported) {native_adreno_import_live[0]=native_adreno_import_live[0]-1;noteImportState(entry->handle,2);}
     clear(*entry);
     return kIOReturnSuccess;
+}
+/* pdx203 usb-210: an IB1 called a 16 KiB draw stream (CP_INDIRECT_BUFFER, once per GMEM tile) whose BO was no longer mapped; the CP's
+ * IB2 fetch took an SMMU translation fault and the GPU never completed anything again (no reset path), so the whole UI froze. Before
+ * a submission goes to the ring, each of its IB1s is read packet by packet (headers only, payloads skipped) and every
+ * CP_INDIRECT_BUFFER / CP_INDIRECT_BUFFER_CHAIN whose target is not wholly mapped is rewritten in place into a CP_NOP of the same length:
+ * that frame misses the stream instead of the GPU hanging. Each one is printed (the first 32) with what the free log knows of the target.
+ * Counters: IB1s scanned, calls checked, calls made NOPs, IB1s whose packets did not parse to their end (scan stopped there). */
+extern "C" {volatile uint32_t native_adreno_ib_guard[4];}
+static uint32_t pm4OddParity(uint32_t value)
+{
+    value^=value>>16;value^=value>>8;value^=value>>4;value&=0xf;
+    return (~0x6996u>>value)&1u;
+}
+static void noteStaleCall(uint64_t ib,uint64_t target,uint32_t dwords,uint32_t submitted,uint32_t completed)
+{
+    static uint32_t printed;
+    if(printed>=32)return;
+    ++printed;
+    const uint32_t count=native_adreno_free_log_count,n=count<256?count:256;
+    const uint64_t ms=native_adreno_vm_now_us?native_adreno_vm_now_us()/1000u:0;
+    for(uint32_t k=0;k<n;++k) {
+        const volatile uint64_t *r=native_adreno_free_log[(count-1-k)&255u];
+        if(target<r[0] || target-r[0]>=r[1])continue;
+        printf("GPUGUARD pid %d ib1 %llx called %llx+%x, unmapped: made a NOP (fence %u, done %u); freed %u frees back, %llu ms ago, "
+               "by pid %u at fence %u done %u\n",proc_selfpid(),(unsigned long long)ib,(unsigned long long)target,dwords,submitted+1,completed,k,
+               (unsigned long long)(ms-(uint32_t)r[4]),(uint32_t)(r[3]>>32),(uint32_t)r[3],(uint32_t)(r[4]>>32));
+        return;
+    }
+    printf("GPUGUARD pid %d ib1 %llx called %llx+%x, unmapped: made a NOP (fence %u, done %u); not among the last %u frees\n",proc_selfpid(),
+           (unsigned long long)ib,(unsigned long long)target,dwords,submitted+1,completed,n);
 }
+static void guardIndirectCalls(const NativeAdrenoVm *vm,void *mapping,uint64_t bo_iova,uint64_t bo_bytes,uint64_t ib,uint64_t bytes,
+    uint32_t submitted,uint32_t completed)
+{
+    if(!vm || !mapping || ib<bo_iova || ib-bo_iova>=bo_bytes || bytes>bo_bytes-(ib-bo_iova))return;
+    volatile uint32_t *words=reinterpret_cast<volatile uint32_t *>(static_cast<char *>(mapping)+(ib-bo_iova));
+    const size_t n=(size_t)(bytes/4);
+    native_adreno_ib_guard[0]=native_adreno_ib_guard[0]+1;
+    bool wrote=false;
+    for(size_t i=0;i<n;) {
+        const uint32_t header=words[i];
+        size_t count;
+        if((header>>28)==7) {
+            count=header&0x3fff;
+            const uint32_t op=(header>>16)&0x7f;
+            if((op==0x3f || op==0x57) && count>=3 && i+3<n) {
+                const uint64_t target=words[i+1]|(uint64_t)words[i+2]<<32;
+                const uint32_t dwords=words[i+3]&0xfffff;
+                native_adreno_ib_guard[1]=native_adreno_ib_guard[1]+1;
+                const uint64_t first=target&~UINT64_C(4095),span=((target&4095)+(uint64_t)dwords*4+4095)&~UINT64_C(4095);
+                if(dwords && !vm->mapped(first,span)) {
+                    words[i]=0x70000000u|(uint32_t)count|pm4OddParity((uint32_t)count)<<15|0x10u<<16|pm4OddParity(0x10)<<23;
+                    wrote=true;
+                    native_adreno_ib_guard[2]=native_adreno_ib_guard[2]+1;
+                    noteStaleCall(ib,target,dwords,submitted,completed);
+                }
+            }
+        } else if((header>>28)==4) {
+            count=header&0x7f;
+        } else {
+            native_adreno_ib_guard[3]=native_adreno_ib_guard[3]+1;
+            break;
+        }
+        i+=1+count;
+    }
+    if(wrote)__asm__ volatile("dsb sy":::"memory");
+}
