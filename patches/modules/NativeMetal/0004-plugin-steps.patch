+// pdx203: a step of this process's plugin, for the kernel's PLUGSTEP row (NativeAdrenoPublish.cpp native_adreno_plugin_steps): the
+// accelerator records the key of a registry property read "NAM:<step>", which needs no connection, so a process that never opens a device
+// (WebKit.GPU, usb-174) still says how far it got.
+static void step(unsigned port, const char *what, int error = 0) {
+    static void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_NOW | RTLD_LOCAL);
+    static auto create = iokit ? (CFTypeRef (*)(unsigned, CFStringRef, CFAllocatorRef, uint32_t))dlsym(iokit, "IORegistryEntryCreateCFProperty") : nullptr;
+    if (!create || !port) return;
+    char key[40];
+    snprintf(key, sizeof key, "NAM:%.24s %d", what, error);
+    CFStringRef name = CFStringCreateWithCString(kCFAllocatorDefault, key, kCFStringEncodingUTF8);
+    if (!name) return;
+    if (CFTypeRef value = create(port, name, kCFAllocatorDefault, 0)) CFRelease(value);
+    CFRelease(name);
+}
