+// pdx203: a step of this process's plugin, for the kernel's PLUGSTEP row (NativeAdrenoPublish.cpp native_adreno_plugin_steps): the
+// accelerator records the key of a registry property read "NAM:<step>", which needs no connection, so a process that never opens a device
+// (WebKit.GPU, usb-174) still says how far it got.
+static void step(unsigned port, const char *what, int error = 0) {
+    static void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_NOW | RTLD_LOCAL);
+    (void)port;
+    char key[40];
+    snprintf(key, sizeof key, "NAM:%.24s %d", what, error);
+    // A sandboxed process may read only the properties its profile names (the WebKit GPU process: no "NAM:" read reached the kernel,
+    // sa40..43), but it may match services: the accelerator records a "NAMStep" key of a matching dictionary as the read above (sa44).
+    static auto matching = iokit ? (CFMutableDictionaryRef (*)(const char *))dlsym(iokit, "IOServiceMatching") : nullptr;
+    static auto getService = iokit ? (unsigned (*)(unsigned, CFDictionaryRef))dlsym(iokit, "IOServiceGetMatchingService") : nullptr;
+    static auto release = iokit ? (int (*)(unsigned))dlsym(iokit, "IOObjectRelease") : nullptr;
+    if (matching && getService) {
+        if (CFMutableDictionaryRef table = matching("IOAcceleratorES")) {
+            CFStringRef value = CFStringCreateWithCString(kCFAllocatorDefault, key + 4, kCFStringEncodingUTF8);
+            if (value) {CFDictionarySetValue(table, CFSTR("NAMStep"), value); CFRelease(value);}
+            if (unsigned found = getService(0, table)) {if (release) release(found);}   // consumes the table
+        }
+    }
+}
