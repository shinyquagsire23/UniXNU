NativeMetal 0006: a held surface import is reused only while its pages are those it pinned; the idle prune at most every 100 ms

0005's hit by surface ID skipped the runtime's remap check (NoCopyPages), so a surface given new pages under the same ID kept
drawing the old ones (sa65/sa68: TestUFO's page header went black). METALROW 12 gains 'stale'.

--- a/NativeBridgeMetalFrontend.mm
+++ b/NativeBridgeMetalFrontend.mm
@@ -820,13 +820,31 @@
 // reused, and its mapping stays valid for the CPU side. Any caller's object for the same surface gets the held import (textures address
 // it by their offset from the surface's base, the same in every mapping). An import goes when no texture has used it for kHeldIdleNs,
 // when the table is over kHeldMax (least recently used first), or on memory pressure.
-struct HeldImport {NBBuffer *buffer;IOSurfaceRef surface;uint64_t lastUse;};
+struct HeldImport {NBBuffer *buffer;IOSurfaceRef surface;uint64_t lastUse,base,pages;};
 // Under gSurfaceImportLock. Never destroyed: a completion thread may still trim it while the process exits.
 static auto &gHeldImports=*new std::map<std::pair<uint64_t,uint64_t>,HeldImport>;
 static std::mutex gSurfaceImportLock;
 static constexpr uint64_t kHeldIdleNs=1500000000ull;   // 1.5 s: WebKit's back buffers come round every 2-3 frames
 static constexpr size_t kHeldMax=96;
-static std::atomic<uint64_t> gSurfaceImportHits,gSurfaceImportOtherObject,gSurfaceImportsPrunedIdle;
+static std::atomic<uint64_t> gSurfaceImportHits,gSurfaceImportOtherObject,gSurfaceImportsPrunedIdle,gSurfaceImportStale;
+// NativeMetal 0006: what the pages under [start, start + length) are, as NativeMetalObjects.rs pages_identity names them (each map
+// entry's leaf VM object id and offset, hashed). A held import is reused only while the surface's mapping is where it was and its pages
+// are those the import pinned: the runtime's own remap check (NoCopyPages) runs only when a buffer is made, which a held hit skips, and
+// IOSurfaces get new pages under the same ID (sa65/sa68: TestUFO's page header, which WebKit does not repaint, went black, while
+// METALROW 13 counted 18849 of 54292 no-copy ranges remapped). False where the range is not all mapped or a page has no object yet.
+static bool pagesIdentity(uint64_t start,uint64_t length,uint64_t *out) {
+ uint64_t hash=1469598103934665603ull;
+ auto mix=[&](uint64_t v){for(int i=0;i<8;++i){hash^=(v>>(8*i))&0xff;hash*=1099511628211ull;}};
+ for(uint64_t at=start,end=start+length;at<end;) {
+  vm_address_t address=(vm_address_t)at;vm_size_t size=0;natural_t depth=64;
+  vm_region_submap_short_info_data_64_t info={};mach_msg_type_number_t count=VM_REGION_SUBMAP_SHORT_INFO_COUNT_64;
+  if(vm_region_recurse_64(mach_task_self(),&address,&size,&depth,(vm_region_recurse_info_t)&info,&count)!=KERN_SUCCESS ||
+     address>at || !info.object_id || !size)return false;
+  mix(at);mix(info.object_id);mix(info.offset+(at-address));
+  at=address+size;
+ }
+ *out=hash;return true;
+}
 static uint64_t heldNow() {return clock_gettime_nsec_np(CLOCK_UPTIME_RAW);}
 // Drops (into `gone`, released by the caller outside the lock) every held import idle for kHeldIdleNs, then the least recently used
 // ones over kHeldMax, or every one when `all`.
@@ -866,9 +884,13 @@
