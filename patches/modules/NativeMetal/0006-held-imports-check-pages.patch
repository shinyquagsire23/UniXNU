+  // The idle walk at most every 100 ms (sa68: about 1.5 % of backboardd's samples were this walk on every new import).
+  static uint64_t prunedAt;
+  const uint64_t now=heldNow();
+  if(now-prunedAt>100000000ull || gHeldImports.size()>=kHeldMax){prunedAt=now;pruneHeldImports(false,gone);}
