  gSurfaceImportsMade++;NBBuffer *buffer=[NBBuffer new];buffer.handle=handle;buffer.options=MTLResourceStorageModeShared;buffer.importedSurface=surface;
  if(identity) {
-  // The idle walk at most every 100 ms (sa68: about 1.5 % of backboardd's samples were this walk on every new import).
-  static uint64_t prunedAt;
   const uint64_t now=heldNow();
-  if(now-prunedAt>100000000ull || gHeldImports.size()>=kHeldMax){prunedAt=now;pruneHeldImports(false,gone);}
+  pruneHeldImports(false,gone);
   uint64_t pages=0;
   if(pagesIdentity((uint64_t)base,bytes,&pages))gHeldImports[{identity,(uint64_t)bytes}]={buffer,surface,now,(uint64_t)base,pages};
  }
