         presenter_ = new gpupresent::Presenter(device, scanout);
+        // pdx203: the copy's submission goes to the display as op 4 (NativeMobileDisplay 0004), which retires the swap early when the
+        // board's knob eretire is 1 and ignores it otherwise; a refusal changes nothing here.
+        presenter_->onScheduled([](void *self) {
+            Client &c = *static_cast<Client *>(self);
+            NGPComplete scheduled = {c.sequence_, 0, 0};
+            if (c.transport_.call(c.transport_.context, kMethodScheduledSwap, &scheduled, sizeof scheduled, nullptr, 0) == 0) ++c.scheduledOk_;
+        }, this);
         note(0x6715);
         if (!presenter_->ready()) return fail(3, 0);
         stats_->step = 4;
@@ -95,6 +102,7 @@
         // reserved: bits 31..24 the flip buffer plus one (0: the scanout's start), bits 23..0 the surface's mapping id
         const uint32_t buffer = swap.reserved >> 24;
         target_ = buffer ? (size_t)(buffer - 1) * frameBytes_ : 0;
+        sequence_ = swap.sequence;
         const gpupresent::Result r = presenter_->present({(const void *)(uintptr_t)swap.address, (size_t)((swap.bytes + page - 1) & ~(page - 1)),
                                                           (size_t)swap.stride, swap.width, swap.height, swap.reserved & 0xffffffu, swap.format,
                                                           target_});
@@ -134,7 +142,9 @@
     Transport transport_ = {};
     gpupresent::Presenter *presenter_ = nullptr;
     gpupresent::Scanout scanout_ = {};
-    size_t frameBytes_ = 0, target_ = 0;   // pdx203: one frame's bytes, and the offset of the buffer the last frame went to
+    size_t frameBytes_ = 0, target_ = 0;
+    static constexpr uint32_t kMethodScheduledSwap = 4;   // NGP_METHOD_SCHEDULED_SWAP (NativeMobileDisplay 0004 NativeGOPPresenter.cpp)
+    uint64_t sequence_ = 0, scheduledOk_ = 0;              // the frame being copied; op 4 calls the kernel accepted   // pdx203: one frame's bytes, and the offset of the buffer the last frame went to
     Stats *stats_ = nullptr;
 };
 
