diff --git a/bsd/vfs/vfs_lookup.c b/bsd/vfs/vfs_lookup.c
--- a/bsd/vfs/vfs_lookup.c
+++ b/bsd/vfs/vfs_lookup.c
@@ -127,6 +127,60 @@ static int              lookup_handle_rsrc_fork(vnode_t dp, struct nameidata *nd
 
 extern lck_rw_t rootvnode_rw_lock;
 
+/* pdx203 per-process file trace: with boot-arg pdx203-trace=NAME, every failed namei of a process of that name and every MAC (sandbox)
+ * denial on a vnode it is checked against prints a TRACE row (operation, errno, path), at most pdx203-trace-max rows (default 1500)
+ * per boot. MobileSafari found none of SafariShared's resources though the kernel resolves them (pdx203 usb-59 PATHDIAG). */
+#include <pexpert/pexpert.h>
+static char native_trace_name[MAXCOMLEN + 1];
+static int native_trace_state = -1;
+static uint32_t native_trace_max = 1500;
+static _Atomic uint32_t native_trace_rows;
+int native_trace_wanted(void);
+void native_trace_row(const char *op, vnode_t vp, const char *path, const char *name, size_t namelen, int error);
+int
+native_trace_wanted(void)
+{
+	if (native_trace_state < 0) {
+		char wanted[64] = {0};
+		uint32_t max = 0;
+		if (PE_parse_boot_argn("pdx203-trace-max", &max, sizeof(max)) && max) {
+			native_trace_max = max;
+		}
+		if (PE_parse_boot_argn("pdx203-trace", wanted, sizeof(wanted)) && wanted[0]) {
+			strlcpy(native_trace_name, wanted, sizeof(native_trace_name));
+			native_trace_state = 1;
+		} else {
+			native_trace_state = 0;
+		}
+	}
+	if (native_trace_state != 1 || os_atomic_load(&native_trace_rows, relaxed) >= native_trace_max) {
+		return 0;
+	}
+	char name[MAXCOMLEN + 1] = {0};
+	proc_selfname(name, sizeof(name));
+	return strcmp(name, native_trace_name) == 0;
+}
+void
+native_trace_row(const char *op, vnode_t vp, const char *path, const char *name, size_t namelen, int error)
+{
+	if (!native_trace_wanted() || os_atomic_inc_orig(&native_trace_rows, relaxed) >= native_trace_max) {
+		return;
+	}
+	char *buffer = NULL;
+	if (!path && vp) {
+		buffer = kalloc_data(MAXPATHLEN, Z_WAITOK | Z_ZERO);
+		int length = MAXPATHLEN;
+		if (buffer && vn_getpath(vp, buffer, &length) == 0) {
+			path = buffer;
+		}
+	}
+	printf("TRACE %s[%d] %s err %d %s%s%.*s\n", native_trace_name, proc_selfpid(), op, error, path ? path : "?",
+	    name ? "/" : "", name ? (int)namelen : 0, name ? name : "");
+	if (buffer) {
+		kfree_data(buffer, MAXPATHLEN);
+	}
+}
+
 /*
  * Convert a pathname into a pointer to a locked inode.
  *
@@ -549,6 +603,9 @@ error_out:
 		rootdir_with_usecount = NULLVP;
 	}
 
+	if (error && cnp->cn_pnbuf && native_trace_wanted()) {
+		native_trace_row("namei", NULLVP, cnp->cn_pnbuf, NULL, 0, error);
+	}
 	if ((cnp->cn_flags & HASBUF)) {
 		cnp->cn_flags &= ~HASBUF;
 		zfree(ZV_NAMEI, cnp->cn_pnbuf);
