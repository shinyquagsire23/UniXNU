diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index 760c339..1109dad 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1910,6 +1910,22 @@ proc_prepareexit(proc_t p, int rv, boolean_t perf_notify)
 		corpse_source = vm_map_is_corpse_source(get_task_map(task));
 	}
 
+	/*
+	 * Bring-up exit log (patches/xnu/zzzzzzzzz-exit-log.patch): every exiting process, how it ended and the exit reason's
+	 * description when it has one (an uncaught exception's reason, a libsystem fault). With panic-on-crash off and no
+	 * crash reports that survive a reboot, this is the record of which daemons crash or quit; the USB log carries it.
+	 */
+	{
+		os_reason_t exit_reason = p->p_exit_reason;
+		char *exit_desc = exit_reason_get_string_desc(exit_reason);
+		printf("EXITLOG %s[%d] %s %d ns %u code 0x%llx%s%.300s\n",
+		    p->p_name, proc_getpid(p), WIFSIGNALED(rv) ? "signal" : "status",
+		    WIFSIGNALED(rv) ? WTERMSIG(rv) : WEXITSTATUS(rv),
+		    exit_reason != OS_REASON_NULL ? exit_reason->osr_namespace : 0,
+		    exit_reason != OS_REASON_NULL ? (unsigned long long)exit_reason->osr_code : 0ULL,
+		    exit_desc ? " why=" : "", exit_desc ? exit_desc : "");
+	}
+
 	/*
 	 * Generate a corefile/crashlog if:
 	 *      The process doesn't have an exit reason that indicates no crash report should be created
